---
/**
 * Tab navigation for different avatar layers (face, clothes, hair, etc.)
 */
---

<div class="layer-tabs" role="tablist" aria-label="Avatar layer selection">
	<!-- Tabs pattern: only the selected tab is in the Tab order; arrows/Home/End move between tabs. -->
	<button
		id="layer-tab-face"
		class="layer-tab active"
		data-layer="face"
		role="tab"
		aria-selected="true"
		aria-controls="layer-content"
		tabindex="0"
		type="button">
		<b>
			<i class="icon-face-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Face</span>
	</button>
	<button
		id="layer-tab-clothes"
		class="layer-tab"
		data-layer="clothes"
		role="tab"
		aria-selected="false"
		aria-controls="layer-content"
		tabindex="-1"
		type="button">
		<b>
			<i class="icon-clothes-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Clothes</span>
	</button>
	<button
		id="layer-tab-hair"
		class="layer-tab"
		data-layer="hair"
		role="tab"
		aria-selected="false"
		aria-controls="layer-content"
		tabindex="-1"
		type="button">
		<b>
			<i class="icon-hair-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Hair</span>
	</button>
	<button
		id="layer-tab-eye"
		class="layer-tab"
		data-layer="eye"
		role="tab"
		aria-selected="false"
		aria-controls="layer-content"
		tabindex="-1"
		type="button">
		<b>
			<i class="icon-eyes-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Eyes</span>
	</button>
	<button
		id="layer-tab-mouth"
		class="layer-tab"
		data-layer="mouth"
		role="tab"
		aria-selected="false"
		aria-controls="layer-content"
		tabindex="-1"
		type="button">
		<b>
			<i class="icon-mouth-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Mouth</span>
	</button>
	<button
		id="layer-tab-background"
		class="layer-tab"
		data-layer="background"
		role="tab"
		aria-selected="false"
		aria-controls="layer-content"
		tabindex="-1"
		type="button">
		<b>
			<i class="icon-background-dark text-3xl"></i>
		</b>
		<span class="layer-tab-text">Background</span>
	</button>
</div>
