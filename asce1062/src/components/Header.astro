---
/**
 * Header Component
 *
 * Top bar with breadcrumb navigation, theme switcher, search button, and site h1.
 * Navigation is now in the Sidebar component.
 */
import "@/styles/components/header.css";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import { mainNavigation, siteMetadata } from "@/data/navigation";

const url = new URL(Astro.url.pathname, Astro.site);
const link = url.pathname.split("/").filter((i) => i);
const currentPath = Astro.url.pathname;
const isSearchPage = currentPath === "/search" || currentPath === "/search/";

// Intermediate breadcrumb segments link only to real sections (navigation.ts is
// the page list). Others (/.well-known, unknown segments on a 404) render as text.
const knownSections = new Set(
	mainNavigation.map((item) => item.href.replace(/\/$/, "")).filter((href) => href.startsWith("/"))
);
const crumbs = link.map((segment, index) => {
	const href = `/${link.slice(0, index + 1).join("/")}`;
	const isCurrent = index === link.length - 1;
	return { segment, href, isCurrent, isLinked: isCurrent || knownSections.has(href) };
});
---

<header>
	<div id="navigation" class="mb-4">
		<button
			type="button"
			class="nav-hamburger"
			aria-controls="nav-menu"
			aria-expanded="false"
			aria-label="Open navigation">
			<i class="icon-list hover:-rotate-6 -mt-[2px]" aria-hidden="true"></i>
		</button>
		<div class="float-right flex flex-col gap-2 -mt-2">
			<ThemeSwitcher default="dark" />
			{!isSearchPage && (
				<button
					id="open-floating-search"
					type="button"
					class="float-right h-11 w-11 transition-[color,transform] duration-100 hover:text-accent hover:rotate-6 cursor-pointer flex items-center justify-center"
					aria-label="Open search">
					<i class="icon-search-heart" aria-hidden="true" />
				</button>
			)}
		</div>

		<b>
			<span class="italic">
				<button
					type="button"
					class="terminal-header-trigger group inline-flex items-center bg-transparent text-inherit transition-colors duration-150 hover:text-secondary focus-visible:text-secondary focus-visible:outline-none"
					data-navbrand-terminal-trigger
					data-navbrand-terminal-source="header-command-palette"
					aria-label="Open terminal">
					<span class="terminal-header-trigger__icon-wrap relative" aria-hidden="true">
						<i class="icon-command-palette terminal-header-trigger__icon inline-block text-xl -skew-x-12"></i>
						<span class="terminal-header-trigger__prompt" aria-hidden="true">
							<span class="terminal-header-trigger__prompt-glyph">&#x276F;</span>
							<span class="blink terminal-header-trigger__prompt-cursor">&#95;</span>
						</span>
					</span>
				</button>
				<span class="group">
					<a class="no-underline group-hover:bg-primary group-hover:text-primary-content transition-colors" href="/">
						&#x24;HOME
					</a>{" "}
					/{" "}
					<a class="no-underline group-hover:bg-primary group-hover:text-primary-content transition-colors" href="/">
						asce1062
					</a>
				</span>
				{crumbs.length > 0 ? (
					<span role="navigation" aria-label="Breadcrumb">
						{crumbs.map(({ segment, href, isCurrent, isLinked }) => (
							<span>
								{" / "}
								{isLinked ? (
									<a class="inline! no-underline" href={href} aria-current={isCurrent ? "page" : undefined}>
										{segment}
									</a>
								) : (
									<span>{segment}</span>
								)}
								{isCurrent && (
									<span class="blink" aria-hidden="true">
										_
									</span>
								)}
							</span>
						))}
					</span>
				) : (
					<span class="blink" aria-hidden="true">
						_
					</span>
				)}
			</span>
		</b>
	</div>
	<p
		class="site-greeting font-retro"
		data-text-effect="decrypt, typing, glitch-lock-on"
		data-text-effect-triggers="load, hover, activate, resume, route-enter, intersection, idle-return, random-effect, random-time">
		{siteMetadata.greeting}
	</p>
	<hr class="w-full h-[1.875px] my-4 border-0 bg-base-300" />
</header>
