---
import type { GuestEntry } from "@/lib/api/guestbook";
import { parseEntryStyle, sanitizeEntryUrl, serializeEntryStyle } from "@/lib/api/guestbook-input";
import { formatDate } from "@/lib/content/utils";
import EntryActions from "@/components/GuestBookEntryActions.astro";
import Haunted from "@/components/Haunted.astro";

interface Props {
	entry: GuestEntry;
}

const { entry } = Astro.props;
const formattedDate = formatDate(entry.timestamp, "medium");

const hasAvatar = entry.avatarOptIn === true && typeof entry.avatarState === "string" && entry.avatarState.length > 0;

// Simple ASCII art detection
// Lines with 2+ consecutive spaces
// Normal prose never has double spaces, but ASCII art relies on them for alignment
const isAsciiArt = / {2}/.test(entry.message);

// Stored values are re-validated at render: rows written before the input
// boundary existed may hold arbitrary style JSON or non-http(s) URLs.
const style = parseEntryStyle(entry.style);
const safeUrl = sanitizeEntryUrl(entry.url);

// Build inline style object (Haunted forwards a flat camelCase style object, unlike the div element which takes the CSS string directly)
const inlineStyles: Record<string, string> = {
	display: "flex",
	...(style.bg !== "none" ? { "--pattern-url": `url(/notecards/${style.bg}.svg)` } : {}),
	borderColor: `var(--color-${style.borderColor})`,
	borderWidth: style.borderWidth,
	borderStyle: style.borderStyle,
	borderRadius: style.borderRadius,
};
---

<article class="entry" id={`entry-${entry.id}`}>
	<Haunted
		tag="div"
		class="entry-bubble"
		style={inlineStyles}
		creature="heart"
		creatureColors={["var(--color-primary)", "var(--color-accent)"]}
		creatureOptions={{ animationTime: 4, numberOf: 12, distance: 400 }}
		disableGlow={true}>
		<div class="entry-top">
			{hasAvatar && (
				<div class="entry-avatar-stamp" title="8-bit avatar">
					<canvas
						class="entry-avatar-canvas avatar-frame"
						data-avatar-state={entry.avatarState}
						width="48"
						height="48"
						aria-hidden="true"
					/>
				</div>
			)}
			<EntryActions
				entryId={entry.id}
				entryName={entry.name}
				entryStyle={entry.style ? serializeEntryStyle(style) : ""}
				entryMessage={entry.message}
				entryAvatarState={hasAvatar ? entry.avatarState : null}
			/>
		</div>
		<pre class:list={["entry-message", { "entry-message--art": isAsciiArt }]}>{entry.message}</pre>
		<div class="entry-meta">
			<h2>
				{safeUrl ? (
					<a href={safeUrl} target="_blank" rel="noopener noreferrer">
						{entry.name}
					</a>
				) : (
					entry.name
				)}
			</h2>
			<time datetime={entry.timestamp.toISOString()}>{formattedDate}</time>
		</div>
	</Haunted>
</article>
