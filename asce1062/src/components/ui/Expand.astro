---
interface Props {
	title: string;
	id?: string;
}
const { title, id } = Astro.props;
const slug = title
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/^-|-$/g, "");
const bodyId = `${id ?? `expand-${slug}`}-body`;
---

<section {id}>
	<div class="block w-full bg-base-200 px-4 shadow-lg">
		<!-- Disclosure pattern: the heading stays a heading, the button inside it toggles. -->
		<h3 class="flex h-14 items-center font-bold">
			<button
				type="button"
				class="expand-toggle flex h-full w-full cursor-pointer items-center border-0 bg-transparent p-0 text-left font-bold text-inherit"
				aria-expanded="false"
				aria-controls={bodyId}>
				{title}
			</button>
		</h3>
		<div id={bodyId} class="expand-body mb-2 overflow-auto" hidden>
			<slot name="content" />
		</div>
	</div>
</section>

<script>
	function initExpand() {
		document.querySelectorAll<HTMLButtonElement>(".expand-toggle").forEach((toggle) => {
			const bodyId = toggle.getAttribute("aria-controls");
			const body = bodyId ? document.getElementById(bodyId) : null;
			if (!body) return;
			toggle.addEventListener("click", () => {
				body.hidden = !body.hidden;
				toggle.setAttribute("aria-expanded", String(!body.hidden));
			});
		});
	}

	document.addEventListener("astro:page-load", initExpand);
</script>
