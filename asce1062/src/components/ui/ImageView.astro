---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * Tailwind only generates classes it can read whole in the source, so the
 * max-width is picked from complete class names instead of built as `max-w-${x}`.
 */
const MAX_WIDTH_CLASSES = {
	xs: "max-w-xs",
	sm: "max-w-sm",
	md: "max-w-md",
	lg: "max-w-lg",
	xl: "max-w-xl",
	"2xl": "max-w-2xl",
	"3xl": "max-w-3xl",
	full: "max-w-full",
} as const;

interface Props {
	image: string;
	altText: string;
	maxWidth?: keyof typeof MAX_WIDTH_CLASSES;
}

const { image, altText, maxWidth = "full" } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/**/*.{jpeg,jpg,png,gif}");
---

<div class="pb-4">
	<figure class="max-w-full">
		<Image
			src={images[image]()}
			alt={altText}
			class:list={["h-auto mx-auto", MAX_WIDTH_CLASSES[maxWidth]]}
			loading="lazy"
			decoding="async"
		/>
		<figcaption class="mt-2 text-sm text-center text-neutral-content">{altText}</figcaption>
	</figure>
</div>
