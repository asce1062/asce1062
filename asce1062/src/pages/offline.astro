---
import Layout from "@/layouts/Layout.astro";
---

<Layout noIndex title="Offline" ogImage="images/social-preview.png" description="You are currently offline">
	<div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
		<h1 class="text-4xl font-bold mb-4 font-retro">You're Offline</h1>
		<p class="text-xl mb-8">
			It looks like you've lost your internet connection.
			<br />
			Don't worry, you can still browse cached pages!
		</p>
		<div id="offline-status" class="mb-4 text-sm opacity-70"></div>
		<div class="flex flex-col sm:flex-row gap-4">
			<button id="retry-btn" class="link-action link-action--primary no-underline">
				<i class="icon-arrow-clockwise text-2xl"></i>Try Again
			</button>
			<a href="/" class="link-action link-action--secondary no-underline">
				<i class="icon-house-heart text-2xl"></i>Go to Home
			</a>
		</div>
	</div>
</Layout>

<script>
	import { OfflineManager } from "@/scripts/offlineManager";

	/** Teardown for the current /offline visit; null when not on the page. */
	let teardown: (() => void) | null = null;

	function initOfflinePage(): void {
		const statusEl = document.getElementById("offline-status");
		if (!statusEl) return; // only /offline has the status element

		const retryBtn = document.getElementById("retry-btn");
		let redirectTimer: ReturnType<typeof setTimeout> | null = null;

		// Save the referrer as the last page if available
		if (document.referrer && document.referrer !== window.location.href) {
			OfflineManager.saveLastPage(document.referrer);
		}

		function updateStatus(online: boolean): void {
			statusEl!.textContent = online ? "Connection restored! Redirecting..." : "You are currently offline";
		}

		// Redirect handler shared by all recovery paths; runs once per visit.
		function handleConnectionRestored(): void {
			if (redirectTimer !== null) return;
			updateStatus(true);
			stopPolling();
			redirectTimer = setTimeout(() => OfflineManager.tryRedirectToLastPage(), 1000);
		}

		retryBtn?.addEventListener("click", () => window.location.reload());

		const cleanupListeners = OfflineManager.setupListeners(
			() => handleConnectionRestored(),
			() => updateStatus(false)
		);
		// Periodic server polling (every 2.5s) as fallback for unreliable online event
		const stopPolling = OfflineManager.startPolling(() => handleConnectionRestored());

		updateStatus(OfflineManager.isOnline());

		// Leaving /offline by soft navigation must stop everything: a later poll
		// success used to redirect the visitor away from whatever page they were on.
		teardown = () => {
			stopPolling();
			cleanupListeners();
			if (redirectTimer !== null) clearTimeout(redirectTimer);
		};
	}

	document.addEventListener("astro:page-load", initOfflinePage);
	document.addEventListener("astro:before-swap", () => {
		teardown?.();
		teardown = null;
	});
</script>
