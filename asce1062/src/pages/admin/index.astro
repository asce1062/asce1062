---
/**
 * Admin hub page
 * Login form verifies a raw token once and stores an opaque signed session cookie
 * Lists all auth-protected pages on the site
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { countPendingEntries } from "@/lib/api/guestbook";
import {
	checkAdminAuth,
	clearAdminSessionCookie,
	createAdminSessionCookie,
	revokeAdminSessions,
	verifyAdminToken,
} from "@/lib/api/admin-auth";

const ADMIN_PAGES = [
	{
		title: "Guestbook Moderation",
		href: "/admin/guestbook",
		description: "Review, approve, or hide pending and flagged entries.",
		icon: "icon-journal-bookmark",
	},
];
const auth = await checkAdminAuth(Astro.cookies);

// Handle POST actions
let loginError: string | null = null;
let loggedOut = false;

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const action = String(formData.get("action") ?? "");

	if (action === "login") {
		const submittedToken = String(formData.get("token") ?? "");
		if (await verifyAdminToken(submittedToken)) {
			if (await createAdminSessionCookie(Astro.cookies)) {
				return Astro.redirect("/admin");
			}
			loginError = "Could not start a session. Try again.";
		} else {
			// Slow down sequential brute-force attempts.
			// Note:
			// 	- on serverless each invocation is isolated
			// 	- this only throttles single-threaded attacks
			await new Promise((r) => setTimeout(r, 500));
			loginError = "Invalid token.";
		}
	}

	if (action === "logout") {
		// Only a genuine session may revoke: an anonymous POST must not be able to
		// sign the moderator out everywhere. A genuine session whose generation could
		// not be read still tries, so a database hiccup is reported, not hidden.
		// The local cookie is cleared either way.
		let revoked = true;
		if (auth.ok || auth.unavailable) {
			try {
				await revokeAdminSessions();
			} catch (err) {
				console.error("[admin] logout could not revoke other sessions", err);
				revoked = false;
			}
		}
		clearAdminSessionCookie(Astro.cookies);
		if (revoked) return Astro.redirect("/admin");
		loggedOut = true;
		loginError = "Signed out here, but other sessions could not be revoked. Log in and out again to retry.";
	}
}

const isAuthed = auth.ok && !loggedOut;
const pendingCount = isAuthed ? await countPendingEntries() : 0;
---

<Layout noIndex title="Admin" description="Admin hub">
	{isAuthed ? (
		<>
			<div class="flex items-center justify-between mb-6 gap-4">
				<h2>Admin</h2>
				<form method="POST">
					<input type="hidden" name="action" value="logout" />
					<button type="submit" class="btn btn-error btn-sm btn-frame">
						Logout
					</button>
				</form>
			</div>

			<div class="space-y-4">
				{ADMIN_PAGES.map((page) => (
					<div class="bg-base-200/60 border border-base-300 p-4 rounded">
						<div class="flex items-start justify-between gap-4">
							<div>
								<i class={page.icon} />
								<a href={page.href} class="font-semibold transition-colors">
									{page.title}
								</a>
								<p class="text-sm text-base-content/60 mt-1 mb-0">{page.description}</p>
							</div>
							<span class={`badge badge-sm shrink-0 mt-0.5 ${pendingCount > 0 ? "badge-info" : "badge-neutral"}`}>
								{pendingCount} pending
							</span>
						</div>
					</div>
				))}
			</div>
		</>
	) : (
		<div class="min-h-[40vh] flex items-center justify-center">
			<div class="w-full max-w-sm p-8 bg-neutral/20 border border-primary">
				<h1 class="font-retro text-2xl text-center mb-6 tracking-widest">[ admin ]</h1>
				<form method="POST" data-astro-reload class="space-y-4">
					<input type="hidden" name="action" value="login" />
					<div class="space-y-1">
						<input
							type="password"
							name="token"
							placeholder="token"
							autocomplete="current-password"
							class="input input-accent w-full"
							autofocus
						/>
						{loginError && <p class="-mt-1 text-error text-sm">{loginError}</p>}
					</div>
					<button type="submit" class="btn btn-secondary btn-pixel w-full">
						Login
					</button>
				</form>
			</div>
		</div>
	)}
</Layout>
