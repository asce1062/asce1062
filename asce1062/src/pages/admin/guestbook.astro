---
/**
 * Admin moderation page for guestbook entries
 * Lists pending/hidden entries with reasons/scores, approve/hide buttons, filter tabs
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { checkAdminAuth } from "@/lib/api/admin-auth";
import { getModeratedEntries, updateEntryStatus, safeParseReasons, getModerationLog } from "@/lib/api/guestbook";
import { deliverRequestedCopy } from "@/lib/api/guestbook-copy";
import { formatDate } from "@/lib/content/utils";
import { sanitizeEntryUrl } from "@/lib/api/guestbook-input";
import type { ModerationStatus } from "@/lib/api/guestbook";

// Defence in depth: middleware enforces auth for /admin/*, but this page holds
// every entry's private data, so it re-checks rather than trusting routing alone.
const auth = await checkAdminAuth(Astro.cookies);
if (!auth.ok) {
	return Astro.redirect("/admin", 303);
}

const FILTERS = ["all", "pending", "hidden", "audit"] as const;
type Filter = (typeof FILTERS)[number];
const ACTIONS = ["approve", "approve-clear", "hide"] as const;
type Action = (typeof ACTIONS)[number];

const isFilter = (value: string | null): value is Filter => FILTERS.includes(value as Filter);
const isAction = (value: string | null): value is Action => ACTIONS.includes(value as Action);

const url = new URL(Astro.request.url);
const requestedFilter = url.searchParams.get("filter");
const filter: Filter = isFilter(requestedFilter) ? requestedFilter : "all";

// Handle moderation actions: POST, then redirect (303) so a reload never repeats
// the action and writes a duplicate audit row. The result travels in the query.
if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const entryId = Number(formData.get("entryId"));
	const action = String(formData.get("action") ?? "");

	if (Number.isInteger(entryId) && entryId > 0 && isAction(action)) {
		const newStatus: ModerationStatus = action === "hide" ? "hidden" : "visible";
		const updated = await updateEntryStatus(entryId, newStatus, { clearFlags: action === "approve-clear" });
		const result = new URLSearchParams({ filter, result: updated ? action : "missing", entry: String(entryId) });
		// A copy the guest asked for goes out once the entry is approved. Awaited:
		// the function stops once the redirect is sent.
		if (updated && newStatus === "visible") {
			const copy = await deliverRequestedCopy(entryId);
			if (copy) result.set("copy", copy.ok ? "sent" : "failed");
		}
		return Astro.redirect(`/admin/guestbook?${result}`, 303);
	}
	return Astro.redirect(`/admin/guestbook?filter=${filter}`, 303);
}

const resultAction = url.searchParams.get("result");
const resultEntry = Number(url.searchParams.get("entry"));
const RESULT_MESSAGES: Record<Action, string> = {
	approve: "approved",
	"approve-clear": "approved and flags cleared",
	hide: "hidden",
};
const COPY_MESSAGES = new Map([
	["sent", " Their requested copy was emailed."],
	["failed", " Their requested copy could not be emailed. Check the function logs."],
]);
const copyMessage = COPY_MESSAGES.get(url.searchParams.get("copy") ?? "") ?? "";
const actionMessage =
	Number.isInteger(resultEntry) && resultEntry > 0
		? isAction(resultAction)
			? `Entry #${resultEntry} ${RESULT_MESSAGES[resultAction]}.${copyMessage}`
			: resultAction === "missing"
				? `Entry #${resultEntry} no longer exists.`
				: ""
		: "";

// Fetch entries
const entries = filter === "audit" ? [] : await getModeratedEntries(filter);
const auditLog = filter === "audit" ? await getModerationLog() : [];
---

<Layout noIndex title="Guestbook Moderation" description="Admin: review guestbook entries">
	<div class="flex items-center justify-between mb-6 gap-4">
		<h2>Guestbook Moderation</h2>
		<a href="/admin" class="btn btn-error btn-sm btn-frame">
			Back to Admin
		</a>
	</div>

	{actionMessage && <div class="mb-4 p-3 bg-success/10 border border-success text-sm">{actionMessage}</div>}

	<nav class="flex gap-2 mb-6">
		<a href={`/admin/guestbook?filter=all`} class:list={["btn btn-sm", { "btn-accent": filter === "all" }]}>
			{" "}
			All{" "}
		</a>
		<a href={`/admin/guestbook?filter=pending`} class:list={["btn btn-sm", { "btn-accent": filter === "pending" }]}>
			Pending
		</a>
		<a href={`/admin/guestbook?filter=hidden`} class:list={["btn btn-sm", { "btn-accent": filter === "hidden" }]}>
			Hidden
		</a>
		<a href={`/admin/guestbook?filter=audit`} class:list={["btn btn-sm", { "btn-accent": filter === "audit" }]}>
			Audit Trail
		</a>
	</nav>

	{filter === "audit" ? (
		auditLog.length === 0 ? (
			<p class="text-base-content/60">No moderation actions recorded yet.</p>
		) : (
			<div class="overflow-x-auto">
				<table class="table table-sm w-full text-xs font-mono">
					<thead>
						<tr class="text-base-content/50">
							<th>Entry</th>
							<th class="text-right">Action</th>
							<th class="text-right">Status change</th>
							<th class="text-right">Reasons before</th>
							<th class="text-right">Score</th>
							<th class="text-right">Actor</th>
							<th class="text-right">At</th>
						</tr>
					</thead>
					<tbody>
						{auditLog.map((row: any) => {
							const reasonsBefore = safeParseReasons(row.reasonsBefore);
							return (
								<tr class="border-t border-base-300">
									<td class="py-2">
										<a href={`/admin/guestbook?filter=all#entry-${row.entryId}`} class="link link-hover">
											#{row.entryId}
										</a>
									</td>
									<td class="py-2 text-right">
										<span
											class:list={[
												"badge badge-sm",
												{
													"badge-secondary": row.action === "approve",
													"badge-success": row.action === "approve_clear",
													"badge-error": row.action === "hide",
												},
											]}>
											{row.action}
										</span>
									</td>
									<td class="py-2 text-right text-base-content/60">
										{row.fromStatus ?? "—"} → {row.toStatus}
									</td>
									<td class="py-2 text-right">
										{reasonsBefore.length > 0 ? (
											<div class="flex flex-wrap justify-end gap-1">
												{reasonsBefore.map((r: string) => (
													<span class="px-1 py-0.5 bg-base-300 rounded">{r}</span>
												))}
											</div>
										) : (
											<span class="text-base-content/30">—</span>
										)}
									</td>
									<td class="py-2 text-right text-base-content/60">{row.scoreBefore ?? "—"}</td>
									<td class="py-2 text-right text-base-content/60">{row.actor}</td>
									<td class="py-2 text-right text-base-content/50 whitespace-nowrap">{formatDate(row.at)}</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		)
	) : entries.length === 0 ? (
		<p class="text-base-content/60">No entries to review.</p>
	) : (
		<div class="space-y-4">
			{entries.map((entry) => {
				const reasons = safeParseReasons(entry.moderationReason);
				const safeUrl = sanitizeEntryUrl(entry.url);
				return (
					<div id={`entry-${entry.id}`} class="p-4 border border-base-300 bg-neutral rounded">
						<div class="flex justify-between items-start mb-2">
							<div>
								<span class="text-xs text-base-content/40 font-mono mr-2">#{entry.id}</span>
								<strong>{entry.name}</strong>
								{safeUrl ? (
									<a href={safeUrl} target="_blank" rel="noopener noreferrer" class="text-xs ml-2">
										{safeUrl}
									</a>
								) : (
									// Show unsafe stored URLs as inert text so a moderator can see them.
									entry.url && <span class="text-xs ml-2 text-error font-mono">{entry.url}</span>
								)}
								{entry.email && <span class="text-xs ml-2 text-base-content/50">{entry.email}</span>}
							</div>
							<div class="flex items-center gap-2">
								<span
									class:list={[
										"text-xs px-2 py-0.5 rounded font-mono",
										{
											"badge badge-warning": entry.status === "pending",
											"badge badge-error": entry.status === "hidden" || entry.isSpam,
											"badge badge-success": entry.status === "visible",
										},
									]}>
									{entry.status || (entry.isSpam ? "hidden (legacy)" : "visible (legacy)")}
								</span>
								{entry.moderationScore != null && <span class="badge">score: {entry.moderationScore}</span>}
							</div>
						</div>

						{reasons.length > 0 && (
							<div class="flex gap-1 mb-2 flex-wrap">
								{reasons.map((r: string) => (
									<span class="text-xs px-1.5 py-0.5 bg-base-300 rounded font-mono">{r}</span>
								))}
							</div>
						)}

						{/* prettier-ignore */}
						<pre class="text-sm whitespace-pre-wrap break-words mb-3 max-h-40 overflow-y-auto bg-base-100 p-2 rounded">{entry.message}</pre>

						<div class="flex justify-between items-center">
							<div>
								<time class="text-xs text-base-content/50">{formatDate(entry.timestamp)}</time>
								{entry.moderatedAt && (
									<p class="text-xs text-base-content/40 mt-0.5">
										moderated by {entry.moderatedBy ?? "admin"} · {formatDate(entry.moderatedAt)}
									</p>
								)}
							</div>
							<form method="POST" class="flex gap-2">
								<input type="hidden" name="entryId" value={entry.id} />
								{(entry.status === "pending" || entry.status === "hidden" || entry.isSpam) && (
									<button type="submit" name="action" value="approve" class="btn btn-secondary btn-sm btn-elevation">
										Approve
									</button>
								)}
								{(entry.status === "pending" || entry.status === "hidden" || entry.isSpam) &&
									entry.moderationReason && (
										<button
											type="submit"
											name="action"
											value="approve-clear"
											class="btn btn-success btn-sm btn-frame"
											title="Approve and remove moderation flags (use for false positives)">
											Approve & Clear
										</button>
									)}
								{(entry.status === "pending" || entry.status === "visible") && (
									<button type="submit" name="action" value="hide" class="btn btn-primary btn-sm btn-pixel">
										Hide
									</button>
								)}
							</form>
						</div>
					</div>
				);
			})}
		</div>
	)}

	<div class="mt-8 text-xs text-base-content/40">
		<p>
			{filter === "audit" ? `Log rows: ${auditLog.length}` : `Entries: ${entries.length}`} | Filter: {filter}
		</p>
	</div>
</Layout>
