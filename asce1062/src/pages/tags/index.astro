---
import Layout from "@/layouts/Layout.astro";
import Columns from "@/components/ui/Columns.astro";
import { getPublishedEntries } from "@/lib/content/published";
import { getAllTags } from "@/lib/content/utils";

const allPosts = await getPublishedEntries("blog");
const allNotes = await getPublishedEntries("notes");
const tags = getAllTags([...allPosts, ...allNotes]);
---

<Layout
	title="Tag Index"
	ogImage="images/social-preview.png"
	description=`bleep bloop indexed ${tags.length == 1 ? "tag" : "tags!"}`>
	<div>
		<h1>tag index</h1>
		<p>
			indexed {tags.length} {tags.length == 1 ? "tag" : "tags!"}
		</p>
		<Columns columns={1}>
			<ul class="list-disc list-inside">
				{tags.map((tag) => (
					<li>
						<a class="italic" href={`/tags/${tag}`}>
							{tag}
						</a>
					</li>
				))}
			</ul>
		</Columns>
	</div>
</Layout>
