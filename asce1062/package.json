{
  "name": "alex mbugua's website",
  "type": "module",
  "version": "0.0.1",
  "homepage": "https://asce1062.github.io/asce1062",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "format": "prettier --write . --ignore-path .prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "predeploy": "npm run generate:ascii && astro check && COMMIT_REF=$(git rev-parse HEAD) astro build",
    "deploy": "gh-pages -d dist --branch alexmbugua --nojekyll --cname alexmbugua.me --dotfiles",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:netlify:preview": "netlify deploy",
    "preview": "astro preview",
    "preview:netlify": "netlify dev",
    "astro": "astro",
    "check": "astro check",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "hash:admin-token": "node scripts/hash-admin-token.mjs",
    "generate:ascii": "node scripts/generate-ascii.mjs",
    "db:setup": "tsx --env-file-if-exists=.env db/setup.ts",
    "db:seed": "npm run db:setup && tsx --env-file-if-exists=.env db/seed.ts",
    "db:import-csv": "npm run db:setup && tsx --env-file-if-exists=.env db/import-csv.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "@pagefind/default-ui": "^1.5.2",
    "@rehype-pretty/transformers": "^0.13.2",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "astro": "^7.4.2",
    "astro-og-canvas": "^0.13.2",
    "astro-pagefind": "^2.0.1",
    "astro-themes": "^0.2.7",
    "autoprefixer": "^10.6.1",
    "drizzle-orm": "^0.45.4",
    "lightningcss": "^1.33.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.31",
    "postcss-nesting": "^14.0.3",
    "reading-time": "^1.5.0",
    "rehype-accessible-emojis": "^0.3.2",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "validator": "^13.15.35",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "figlet": "^1.12.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "netlify-cli": "^27.14.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-toml": "^4.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "toml": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,mjs,astro}": [
      "eslint --fix",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{json,md,mdx,css,yml,yaml,toml}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
