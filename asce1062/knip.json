{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": ["pagefind", "lightningcss", "autoprefixer", "postcss-nesting", "lint-staged"],
  "ignore": ["public/fonts/**", "public/**/demo-files/**"],

  "entry": [
    "astro.config.*",
    "vitest.config.*",
    "markdown.config.ts",
    "lighthouserc.cjs",
    "src/pages/**/*.{astro,mdx}",
    "src/components/MagicalText.astro",
    "scripts/**/*.{ts,js,mjs}",
    "db/**/*.{ts,js}",
    "src/**/*.test.{ts,js}"
  ],

  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
    "function": true
  },

  "ignoreIssues": {
    "src/lib/email/templates/**/*.astro": ["types"],
    "src/lib/email/helpers/**": ["exports"]
  }
}
